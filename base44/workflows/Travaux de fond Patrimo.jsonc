{
  "name": "Travaux de fond Patrimo",
  "description": "Chaque jour \u00e0 06h (Europe/Paris), ex\u00e9cute les automatisations de fond (\u00e9ch\u00e9ances, impay\u00e9s, docs expirants, r\u00e9visions disponibles) en arri\u00e8re-plan pour tous les patrimoines. Idempotent et journalis\u00e9 (JobRun).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "Europe/Paris",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "travaux_de_fond_patrimo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "executer_jobs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runBackgroundJobs",
            "args": {
              "all_owners": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Ex\u00e9cuter les jobs de fond",
            "description": "\u00c9ch\u00e9ances, impay\u00e9s, docs expirants, r\u00e9visions \u2014 idempotent"
          }
        }
      }
    ]
  }
}