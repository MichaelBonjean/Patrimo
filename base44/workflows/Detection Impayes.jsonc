  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 10 * *",
      "one_time_date": null,
      "timezone": "Europe/Paris",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "detection_impayes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "detecter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "detectImpayes",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "D\u00e9tecter les impay\u00e9s",
